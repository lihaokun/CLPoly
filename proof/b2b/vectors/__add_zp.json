{
  "fn": "__add_zp",
  "cases": [
    {
      "name": "basic",
      "args": [
        {"type": "Zp", "val": ["3", "7"]},
        {"type": "Zp", "val": ["5", "7"]}
      ],
      "expected": {"type": "Zp", "val": ["1", "7"]}
    },
    {
      "name": "zero_zero",
      "args": [
        {"type": "Zp", "val": ["0", "7"]},
        {"type": "Zp", "val": ["0", "7"]}
      ],
      "expected": {"type": "Zp", "val": ["0", "7"]}
    },
    {
      "name": "wrap_to_zero",
      "args": [
        {"type": "Zp", "val": ["6", "7"]},
        {"type": "Zp", "val": ["1", "7"]}
      ],
      "expected": {"type": "Zp", "val": ["0", "7"]}
    },
    {
      "name": "wrap_5_5",
      "args": [
        {"type": "Zp", "val": ["5", "7"]},
        {"type": "Zp", "val": ["5", "7"]}
      ],
      "expected": {"type": "Zp", "val": ["3", "7"]}
    },
    {
      "name": "max_wrap",
      "args": [
        {"type": "Zp", "val": ["6", "7"]},
        {"type": "Zp", "val": ["6", "7"]}
      ],
      "expected": {"type": "Zp", "val": ["5", "7"]}
    },
    {
      "name": "p13_basic",
      "args": [
        {"type": "Zp", "val": ["10", "13"]},
        {"type": "Zp", "val": ["7", "13"]}
      ],
      "expected": {"type": "Zp", "val": ["4", "13"]}
    },
    {
      "name": "large_prime_basic",
      "args": [
        {"type": "Zp", "val": ["1000000000", "4294967311"]},
        {"type": "Zp", "val": ["3000000000", "4294967311"]}
      ],
      "expected": {"type": "Zp", "val": ["4000000000", "4294967311"]}
    },
    {
      "name": "large_prime_wrap",
      "args": [
        {"type": "Zp", "val": ["4294967310", "4294967311"]},
        {"type": "Zp", "val": ["1", "4294967311"]}
      ],
      "expected": {"type": "Zp", "val": ["0", "4294967311"]}
    }
  ]
}
