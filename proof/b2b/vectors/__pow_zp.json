      "expected": {"type": "Zp", "val": ["10", "13"]}
    },
    {
      "name": "pow_5_0_mod_11",
      "args": [
        {"type": "Zp", "val": ["5", "11"]},
        {"type": "Int64", "val": 0}
      ],
      "expected": {"type": "Zp", "val": ["1", "11"]}
    },
    {
      "name": "pow_5_1_mod_11",
      "args": [
        {"type": "Zp", "val": ["5", "11"]},
        {"type": "Int64", "val": 1}
