{
  "fn": "__sub_zp",
  "cases": [
    {
      "name": "basic",
      "args": [
        {"type": "Zp", "val": ["5", "7"]},
        {"type": "Zp", "val": ["3", "7"]}
      ],
      "expected": {"type": "Zp", "val": ["2", "7"]}
    },
    {
      "name": "neg_wrap",
      "args": [
        {"type": "Zp", "val": ["3", "7"]},
        {"type": "Zp", "val": ["5", "7"]}
      ],
      "expected": {"type": "Zp", "val": ["5", "7"]}
    },
    {
      "name": "zero_minus_one",
      "args": [
        {"type": "Zp", "val": ["0", "7"]},
        {"type": "Zp", "val": ["1", "7"]}
      ],
      "expected": {"type": "Zp", "val": ["6", "7"]}
    },
    {
      "name": "zero_zero",
      "args": [
        {"type": "Zp", "val": ["0", "7"]},
        {"type": "Zp", "val": ["0", "7"]}
      ],
      "expected": {"type": "Zp", "val": ["0", "7"]}
    },
    {
      "name": "self",
      "args": [
        {"type": "Zp", "val": ["5", "13"]},
        {"type": "Zp", "val": ["5", "13"]}
      ],
      "expected": {"type": "Zp", "val": ["0", "13"]}
    },
    {
      "name": "max_minus_zero",
      "args": [
        {"type": "Zp", "val": ["12", "13"]},
        {"type": "Zp", "val": ["0", "13"]}
      ],
      "expected": {"type": "Zp", "val": ["12", "13"]}
    },
    {
      "name": "large_prime_underflow",
      "args": [
        {"type": "Zp", "val": ["5", "4294967311"]},
        {"type": "Zp", "val": ["10", "4294967311"]}
      ],
      "expected": {"type": "Zp", "val": ["4294967306", "4294967311"]}
    },
    {
      "name": "large_prime_basic",
      "args": [
        {"type": "Zp", "val": ["3000000000", "4294967311"]},
        {"type": "Zp", "val": ["1000000000", "4294967311"]}
      ],
      "expected": {"type": "Zp", "val": ["2000000000", "4294967311"]}
    }
  ]
}
